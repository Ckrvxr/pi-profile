{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "exposure": "direct"
    },
    "paper-search": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--with",
        "mcp<2",
        "paper-search-mcp"
      ],
      "exposure": "codemode"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "exposure": "codemode"
    },
    "cua-driver": {
      "command": "cua-driver",
      "args": [
        "mcp"
      ],
      "exposure": "codemode",
      "description": "Control desktop applications through Cua Driver MCP."
    }
  }
}
