{
  "packages": [
    "npm:pi-web-access",
    "npm:@normful/pi-auto-name",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:awesome-pi-themes",
    "npm:pi-zentui",
    "npm:pi-bash-highlight",
    "npm:pi-mac-session-native-compression",
    "npm:@howaboua/pi-codex-imagegen"
  ],
  "lastChangelogVersion": "1.3.0",
  "theme": "rainbow-prism",
  "images": {
    "autoResize": false
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "autocompleteMaxVisible": 15,
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "openai/gpt-6-luna"
  ],
  "defaultThinkingLevel": "max",
  "terminal": {
    "imageWidthCells": 120,
    "showTerminalProgress": true
  },
  "treeFilterMode": "no-tools",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "defaultProjectTrust": "always",
  "editorPaddingX": 0,
  "hideThinkingBlock": false,
  "outputPad": 1,
  "cacheWarming": "idle",
  "showHardwareCursor": true
}