{
  "packages": [
    "npm:pi-web-access",
    "npm:@normful/pi-auto-name",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-zentui",
    "npm:pi-bash-highlight",
    "npm:@howaboua/pi-codex-imagegen",
    "npm:@tintinweb/pi-subagents"
  ],
  "lastChangelogVersion": "1.5.2",
  "theme": "system",
  "images": {
    "autoResize": false
  },
  "defaultProvider": "magpie",
  "defaultModel": "opencode-go/deepseek-v4.1-flash",
  "autocompleteMaxVisible": 15,
  "defaultThinkingLevel": "max",
  "retry": {
    "enabled": true,
    "maxRetries": 99,
    "maxAgentDelayMs": 60000
  },
  "terminal": {
    "imageWidthCells": 120,
    "showTerminalProgress": true
  },
  "treeFilterMode": "no-tools",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "defaultProjectTrust": "always",
  "editorPaddingX": 0,
  "hideThinkingBlock": false,
  "outputPad": 1,
  "cacheWarming": "idle",
  "showHardwareCursor": true,
  "compaction": {
    "enabled": true
  },
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "high",
    "openai-codex/gpt-6-luna": "max",
    "openai-codex/gpt-6-astra": "high"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@normful/pi-auto-name\",\"scope\":\"user\"}": "2.1.0",
    "{\"source\":\"npm:@howaboua/pi-codex-imagegen\",\"scope\":\"user\"}": "0.0.14",
    "{\"source\":\"npm:@tintinweb/pi-subagents\",\"scope\":\"user\"}": "0.26.0"
  }
}